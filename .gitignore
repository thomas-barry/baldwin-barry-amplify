# Logs
# Anchored: an unanchored `logs` matches any directory of that name at any
# depth, which silently swallowed src/modules/admin/logs and src/routes/admin/logs.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
build
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code — ignore .claude/ except the subagent definitions, which are versioned.
# Agent memory stays ignored: this repo is public.
# `.claude/*` rather than `.claude/`: git can't re-include files under an ignored directory.
.worktrees/
.claude/*
!.claude/agents/

# AWS infrastructure artifacts
.aws-sam/
dev-permissions.json
prod-permissions.json

# amplify
.amplify
amplify_outputs*
amplifyconfiguration*
.worktrees

#playwright
.playwright-cli/

# TanStack tooling
.tanstack/

# npm cache used by amplify.yml (`npm ci --cache .npm`)
.npm/
